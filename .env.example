DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# S5-002: Anthropic provider (lib/ai/providers/anthropic.ts), registered
# in AIProviderRegistry alongside Gemini and OpenAI. Selected via
# DEFAULT_AI_PROVIDER below, or per-call, per S5-004's routing rules
# (lib/ai/provider-resolver.ts) -- not used by any real generation unless
# explicitly selected.
ANTHROPIC_API_KEY=
# S5-003: OpenAI provider (lib/ai/providers/openai.ts), same registration/
# selection status as ANTHROPIC_API_KEY above.
OPENAI_API_KEY=
# S5-004: selects which registered AI provider (gemini/anthropic/openai)
# serves a generation when the caller doesn't explicitly request one --
# see lib/ai/provider-resolver.ts's resolveAIProvider() for the full
# routing priority (explicit choice > this variable > Gemini fallback).
# Deliberately no automatic failover between providers -- see that file's
# own scope note.
DEFAULT_AI_PROVIDER=gemini
# Absolute origin used to build the password-reset email's redirect link
# (Supabase Auth requires a full URL, not a relative path). Falls back to
# http://localhost:3000 in local dev if unset.
NEXT_PUBLIC_SITE_URL=
